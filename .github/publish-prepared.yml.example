# Prepared publication workflow. It is deliberately outside workflows/.
# Activate only after author-approved licensing, PyPI ownership, environment
# protections and an explicit publication task identify the exact artifacts.
name: Publish previously verified artifacts
on:
  workflow_dispatch:
    inputs:
      build_run_id:
        description: 'Successful release-candidate run whose bytes were approved'
        required: true
      source_commit:
        description: 'Exact 40-character source commit in the approved manifest'
        required: true
      index:
        type: choice
        options: [testpypi, pypi]
        required: true
permissions:
  contents: read
jobs:
  publish:
    runs-on: ubuntu-24.04
    environment: ${{ inputs.index }}
    permissions:
      actions: read
      id-token: write
    steps:
      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093
        with:
          github-token: ${{ github.token }}
          run-id: ${{ inputs.build_run_id }}
          name: equiframe-candidate-${{ inputs.source_commit }}
          path: approved
      - name: Check commit and every approved artifact hash
        env:
          EXPECTED_COMMIT: ${{ inputs.source_commit }}
        run: |
          python - <<'PY'
          import hashlib,json,os,pathlib,shutil
          root=pathlib.Path('approved')
          output=pathlib.Path('upload'); output.mkdir()
          manifests=list(root.rglob('*-manifest.json'))
          if len(manifests)!=2: raise SystemExit('exactly two identified manifests required')
          required={'locked_sync','ruff_check','ruff_format','mypy','assets','pytest','build','twine','distribution'}
          distributions=set()
          for path in manifests:
              manifest=json.loads(path.read_text())
              if manifest['source_commit']!=os.environ['EXPECTED_COMMIT']: raise SystemExit('wrong source commit')
              if manifest['publication_blockers']: raise SystemExit('unresolved publication decisions')
              source=manifest['source_validation']
              if source['git_head']!=os.environ['EXPECTED_COMMIT'] or source['package_clean'] is not True or source['project_tracked'] is not True: raise SystemExit('unverified package source')
              checks=manifest['check_completion']
              if set(checks['required_stages'])!=required or set(checks['successful_stages'])!=required or checks['missing_stages'] or checks['failed_commands']!=0: raise SystemExit('incomplete candidate checks')
              if set(checks.get('source_bound_stages', []))!=required or checks.get('unbound_stages', required): raise SystemExit('checks not bound to current source and artifacts')
              name=manifest['distribution']
              if name not in {'equiframe','equiframe-benchmark'} or name in distributions: raise SystemExit('unexpected or repeated distribution')
              distributions.add(name)
              stem=name.replace('-','_')+'-'+manifest['version']
              expected_files={stem+'-py3-none-any.whl',stem+'.tar.gz'}
              if len(manifest['artifacts'])!=2 or {item['file'] for item in manifest['artifacts']}!=expected_files: raise SystemExit('unexpected artifact inventory')
              for item in manifest['artifacts']:
                  artifact=path.parent/item['file']
                  if artifact.stat().st_size!=item['size_bytes'] or hashlib.sha256(artifact.read_bytes()).hexdigest()!=item['sha256']: raise SystemExit('artifact integrity differs')
                  shutil.copy2(artifact,output/artifact.name)
          PY
      - uses: pypa/gh-action-pypi-publish@dc37677b2e1c63e2034f94d8a5b11f265b73ba33
        with:
          packages-dir: upload/
          repository-url: ${{ inputs.index == 'testpypi' && 'https://test.pypi.org/legacy/' || 'https://upload.pypi.org/legacy/' }}
