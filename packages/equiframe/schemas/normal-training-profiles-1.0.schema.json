            "discriminator": {
              "mapping": {
                "boolean": "#/$defs/BooleanValue",
                "date": "#/$defs/DateValue",
                "decimal": "#/$defs/DecimalValue",
                "float": "#/$defs/FloatValue",
                "infinity": "#/$defs/InfinityValue",
                "integer": "#/$defs/IntegerValue",
                "nan": "#/$defs/NaNValue",
                "null": "#/$defs/NullValue",
                "string": "#/$defs/StringValue",
                "timestamp": "#/$defs/TimestampValue"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/NullValue"
              },
              {
                "$ref": "#/$defs/NaNValue"
              },
              {
                "$ref": "#/$defs/InfinityValue"
              },
              {
                "$ref": "#/$defs/BooleanValue"
              },
              {
                "$ref": "#/$defs/IntegerValue"
              },
              {
                "$ref": "#/$defs/StringValue"
              },
              {
                "$ref": "#/$defs/DecimalValue"
              },
              {
                "$ref": "#/$defs/FloatValue"
              },
              {
                "$ref": "#/$defs/DateValue"
              },
              {
                "$ref": "#/$defs/TimestampValue"
              }
            ]
          },
          "title": "Allowed Values",
          "type": "array"
        },
        "logical_type": {
          "discriminator": {
            "mapping": {
              "boolean": "#/$defs/BooleanType",
              "date": "#/$defs/DateType",
              "decimal": "#/$defs/DecimalType",
              "float": "#/$defs/FloatType",
              "integer": "#/$defs/IntegerType",
              "string": "#/$defs/StringType",
              "timestamp": "#/$defs/TimestampType"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/BooleanType"
            },
            {
              "$ref": "#/$defs/IntegerType"
            },
            {
              "$ref": "#/$defs/StringType"
            },
            {
              "$ref": "#/$defs/DecimalType"
            },
            {
              "$ref": "#/$defs/FloatType"
            },
            {
              "$ref": "#/$defs/DateType"
            },
            {
              "$ref": "#/$defs/TimestampType"
            }
          ],
          "title": "Logical Type"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "nan_policy": {
          "anyOf": [
            {
              "$ref": "#/$defs/NaNPolicy"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "null_policy": {
          "$ref": "#/$defs/NullPolicy"
        },
        "nullable": {
          "title": "Nullable",
          "type": "boolean"
        },
        "numeric_policy": {
          "anyOf": [
            {
              "$ref": "#/$defs/NumericPolicy"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "temporal_policy": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "date": "#/$defs/DatePolicy",
                  "timestamp": "#/$defs/TimestampPolicy"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/DatePolicy"
                },
                {
                  "$ref": "#/$defs/TimestampPolicy"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temporal Policy"
        }
      },
      "required": [
        "name",
        "logical_type",
        "nullable",
        "null_policy"
      ],
      "title": "ColumnSpec",
      "type": "object"
    },
