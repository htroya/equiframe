        "$ref": "#/$defs/BundleReference"
      },
      "title": "References",
      "type": "array"
    },
    "root_document": {
      "minLength": 1,
      "title": "Root Document",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "kind",
    "root_document",
    "files",
    "references",
    "producer_version"
