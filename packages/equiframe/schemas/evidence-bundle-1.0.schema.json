        },
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "member"
      ],
      "title": "BundleReference",
      "type": "object"
    },
    "EvidenceFile": {
