{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "enum": [
            "json",
            "jsonl",
            "arrow",
            "parquet"
          ],
          "title": "Format",
          "type": "string"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "schema_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/SchemaRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "uri",
        "sha256",
        "format",
        "media_type",
        "size_bytes"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "EvidenceFile": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "EvidenceFile",
      "type": "object"
    },
    "ReducedTable": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "original": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "original_rows": {
          "minimum": 0,
          "title": "Original Rows",
          "type": "integer"
        },
        "reduced": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "retained_positions": {
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "title": "Retained Positions",
          "type": "array"
        }
      },
      "required": [
        "name",
        "original",
        "reduced",
        "original_rows",
        "retained_positions"
      ],
      "title": "ReducedTable",
      "type": "object"
    },
    "ReductionOptions": {
      "additionalProperties": false,
      "properties": {
        "confirmations": {
          "default": 2,
          "maximum": 5,
          "minimum": 1,
          "title": "Confirmations",
          "type": "integer"
        },
        "max_evaluations": {
          "default": 100,
          "exclusiveMinimum": 0,
          "title": "Max Evaluations",
          "type": "integer"
        },
        "max_input_rows": {
          "default": 100000,
          "exclusiveMinimum": 0,
          "title": "Max Input Rows",
          "type": "integer"
        },
        "timeout_seconds": {
          "default": 60.0,
          "exclusiveMinimum": 0,
          "title": "Timeout Seconds",
          "type": "number"
        }
      },
      "title": "ReductionOptions",
      "type": "object"
    },
    "SchemaRef": {
      "additionalProperties": false,
      "properties": {
        "revision": {
          "exclusiveMinimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "schema_id": {
          "minLength": 1,
          "title": "Schema Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "schema_id",
        "revision",
        "sha256"
      ],
      "title": "SchemaRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "accepted_candidates": {
      "minimum": 0,
      "title": "Accepted Candidates",
      "type": "integer"
    },
    "baseline_verified": {
      "title": "Baseline Verified",
      "type": "boolean"
    },
    "elapsed_seconds": {
      "minimum": 0,
      "title": "Elapsed Seconds",
      "type": "number"
    },
    "evaluations": {
      "minimum": 0,
      "title": "Evaluations",
      "type": "integer"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceFile"
      },
      "title": "Evidence",
      "type": "array"
    },
    "failure_signature": {
      "minLength": 1,
      "title": "Failure Signature",
      "type": "string"
    },
    "global_minimum_claimed": {
      "const": false,
      "default": false,
      "title": "Global Minimum Claimed",
      "type": "boolean"
    },
    "minimality": {
      "enum": [
        "one_minimal",
        "not_established"
      ],
      "title": "Minimality",
      "type": "string"
    },
    "options": {
      "$ref": "#/$defs/ReductionOptions"
    },
    "predicate_version": {
      "minLength": 1,
      "title": "Predicate Version",
      "type": "string"
    },
    "reduction_id": {
      "minLength": 1,
      "title": "Reduction Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "reduced",
        "unchanged",
        "budget_exhausted",
        "cancelled",
        "invalid_baseline",
        "evaluation_failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "tables": {
      "items": {
        "$ref": "#/$defs/ReducedTable"
      },
      "title": "Tables",
      "type": "array"
    }
  },
  "required": [
    "reduction_id",
    "predicate_version",
    "failure_signature",
    "options",
    "status",
    "baseline_verified",
    "evaluations",
    "accepted_candidates",
    "elapsed_seconds",
    "minimality",
    "tables",
    "evidence"
  ],
  "title": "ReductionResult",
  "type": "object"
}
