{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "enum": [
            "json",
            "jsonl",
            "arrow",
            "parquet"
          ],
          "title": "Format",
          "type": "string"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "schema_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/SchemaRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "uri",
        "sha256",
        "format",
        "media_type",
        "size_bytes"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ComparisonValue": {
      "additionalProperties": false,
      "description": "Lossless scalar evidence. Numeric text; dates/instants use integer epochs.",
      "properties": {
        "kind": {
          "enum": [
            "null",
            "nan",
            "infinity",
            "boolean",
            "integer",
            "string",
            "decimal",
            "float",
            "date",
            "timestamp"
          ],
          "title": "Kind",
          "type": "string"
        },
        "timezone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timezone"
        },
        "unit": {
          "anyOf": [
            {
              "enum": [
                "day",
                "s",
                "ms",
                "us",
                "ns"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "kind"
      ],
      "title": "ComparisonValue",
      "type": "object"
    },
    "RuleFinding": {
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "minLength": 1,
          "title": "Check Id",
          "type": "string"
        },
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Column"
        },
        "expected": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ComparisonValue"
          },
          "title": "Expected",
          "type": "array"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "observed": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ComparisonValue"
          },
          "title": "Observed",
          "type": "array"
        },
        "position": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Position"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "table": {
          "minLength": 1,
          "title": "Table",
          "type": "string"
        }
      },
      "required": [
        "check_id",
        "code",
        "table",
        "message"
      ],
      "title": "RuleFinding",
      "type": "object"
    },
    "SchemaRef": {
      "additionalProperties": false,
      "properties": {
        "revision": {
          "exclusiveMinimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "schema_id": {
          "minLength": 1,
          "title": "Schema Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "schema_id",
        "revision",
        "sha256"
      ],
      "title": "SchemaRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "check_id": {
      "minLength": 1,
      "title": "Check Id",
      "type": "string"
    },
    "complete": {
      "title": "Complete",
      "type": "boolean"
    },
    "examined_rows": {
      "default": 0,
      "minimum": 0,
      "title": "Examined Rows",
      "type": "integer"
    },
    "examples": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RuleFinding"
      },
      "title": "Examples",
      "type": "array"
    },
    "findings": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "implementation": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Implementation"
    },
    "kind": {
      "enum": [
        "precondition",
        "rule"
      ],
      "title": "Kind",
      "type": "string"
    },
    "reason": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    },
    "required": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Required"
    },
    "revision": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Revision"
    },
    "severity": {
      "anyOf": [
        {
          "enum": [
            "info",
            "warning",
            "error"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Severity"
    },
    "state": {
      "enum": [
        "satisfied",
        "violated",
        "not_applicable",
        "not_evaluable"
      ],
      "title": "State",
      "type": "string"
    },
    "violation_count": {
      "default": 0,
      "minimum": 0,
      "title": "Violation Count",
      "type": "integer"
    }
  },
  "required": [
    "check_id",
    "kind",
    "state",
    "complete"
  ],
  "title": "CheckResult",
  "type": "object"
}
