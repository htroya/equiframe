{
  "$defs": {
    "ComponentDecision": {
      "additionalProperties": false,
      "properties": {
        "complete": {
          "title": "Complete",
          "type": "boolean"
        },
        "decision": {
          "enum": [
            "alert",
            "no_alert",
            "not_evaluable"
          ],
          "title": "Decision",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "decision",
        "complete"
      ],
      "title": "ComponentDecision",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One unique native execution; migration is declared, never guessed from IDs.",
  "properties": {
    "b": {
      "$ref": "#/$defs/ComponentDecision"
    },
    "b_score": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "const": "+infinity",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "B Score"
    },
    "candidate_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Candidate Sha256",
      "type": "string"
    },
    "case_id": {
      "minLength": 1,
      "title": "Case Id",
      "type": "string"
    },
    "detector_bundle_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Detector Bundle Sha256"
    },
    "engine": {
      "enum": [
        "pandas",
        "polars",
        "duckdb"
      ],
      "title": "Engine",
      "type": "string"
    },
    "failure_reason": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Reason"
    },
    "family": {
      "enum": [
        "nulls_types",
        "joins",
        "duplicates_order",
        "aggregations",
        "dates"
      ],
      "title": "Family",
      "type": "string"
    },
    "freeze_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Freeze Sha256"
    },
    "group_id": {
      "minLength": 1,
      "title": "Group Id",
      "type": "string"
    },
    "h": {
      "$ref": "#/$defs/ComponentDecision"
    },
    "m": {
      "$ref": "#/$defs/ComponentDecision"
    },
    "m_score": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "M Score"
    },
    "migration": {
      "minLength": 1,
      "title": "Migration",
      "type": "string"
    },
    "oracle_label": {
      "anyOf": [
        {
          "enum": [
            "normal",
            "divergent"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Oracle Label"
    },
    "oracle_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Oracle Sha256"
    },
    "oracle_state": {
      "enum": [
        "pending",
        "disagreement",
        "confirmed",
        "not_evaluable"
      ],
      "title": "Oracle State",
      "type": "string"
    },
    "pipeline_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Pipeline Sha256"
    },
    "r": {
      "$ref": "#/$defs/ComponentDecision"
    },
    "scenario_id": {
      "minLength": 1,
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "case_id",
    "scenario_id",
    "group_id",
    "family",
    "migration",
    "engine",
    "candidate_sha256",
    "pipeline_sha256",
    "oracle_sha256",
    "oracle_state",
    "oracle_label",
    "r",
    "m",
    "b",
    "h",
    "m_score",
    "b_score",
    "detector_bundle_sha256",
    "freeze_sha256"
  ],
  "title": "EvaluationRecord",
  "type": "object"
}
