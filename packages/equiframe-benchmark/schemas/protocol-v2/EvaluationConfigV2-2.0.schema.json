{
  "$defs": {
    "BootstrapPlan": {
      "additionalProperties": false,
      "description": "Explicit support justification; a group count alone never proves independence.",
      "properties": {
        "confidence": {
          "default": "0.95",
          "minLength": 1,
          "title": "Confidence",
          "type": "string"
        },
        "independence_supported": {
          "title": "Independence Supported",
          "type": "boolean"
        },
        "min_groups": {
          "minimum": 1,
          "title": "Min Groups",
          "type": "integer"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "repetitions": {
          "default": 2000,
          "minimum": 1,
          "title": "Repetitions",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "seed": {
          "maximum": 4294967295,
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        }
      },
      "required": [
        "seed",
        "min_groups",
        "independence_supported",
        "rationale"
      ],
      "title": "BootstrapPlan",
      "type": "object"
    },
    "ContrastSpecV2": {
      "additionalProperties": false,
      "properties": {
        "left": {
          "enum": [
            "R",
            "M",
            "B",
            "H"
          ],
          "title": "Left",
          "type": "string"
        },
        "right": {
          "enum": [
            "R",
            "M",
            "B",
            "H"
          ],
          "title": "Right",
          "type": "string"
        },
        "schema_version": {
          "const": "2.0",
          "default": "2.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "left",
        "right"
      ],
      "title": "ContrastSpecV2",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "bootstrap": {
      "$ref": "#/$defs/BootstrapPlan"
    },
    "contrasts": {
      "items": {
        "$ref": "#/$defs/ContrastSpecV2"
      },
      "maxItems": 6,
      "minItems": 1,
      "title": "Contrasts",
      "type": "array"
    },
    "expected_families": {
      "default": [
        "nulls_types",
        "joins",
        "aggregations"
      ],
      "items": {
        "enum": [
          "nulls_types",
          "joins",
          "duplicates_order",
          "aggregations",
          "dates"
        ],
        "type": "string"
      },
      "title": "Expected Families",
      "type": "array"
    },
    "expected_migrations": {
      "default": [
        "pandas-polars",
        "pandas-duckdb",
        "polars-duckdb"
      ],
      "items": {
        "enum": [
          "pandas-polars",
          "pandas-duckdb",
          "polars-duckdb"
        ],
        "type": "string"
      },
      "title": "Expected Migrations",
      "type": "array"
    },
    "freeze_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Freeze Sha256"
    },
    "mode": {
      "enum": [
        "pilot",
        "final"
      ],
      "title": "Mode",
      "type": "string"
    },
    "protocol": {
      "const": "paired-principal-2.0",
      "default": "paired-principal-2.0",
      "title": "Protocol",
      "type": "string"
    },
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "mode",
    "freeze_sha256",
    "bootstrap",
    "contrasts"
  ],
  "title": "EvaluationConfigV2",
  "type": "object"
}
