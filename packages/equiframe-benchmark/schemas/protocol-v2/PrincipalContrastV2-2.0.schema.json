{
  "$defs": {
    "ConfusionMetrics": {
      "additionalProperties": false,
      "properties": {
        "f1": {
          "$ref": "#/$defs/MetricValue"
        },
        "false_positive_rate": {
          "$ref": "#/$defs/MetricValue"
        },
        "fn": {
          "minimum": 0,
          "title": "Fn",
          "type": "integer"
        },
        "fp": {
          "minimum": 0,
          "title": "Fp",
          "type": "integer"
        },
        "precision": {
          "$ref": "#/$defs/MetricValue"
        },
        "recall": {
          "$ref": "#/$defs/MetricValue"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "tn": {
          "minimum": 0,
          "title": "Tn",
          "type": "integer"
        },
        "tp": {
          "minimum": 0,
          "title": "Tp",
          "type": "integer"
        }
      },
      "required": [
        "tp",
        "fp",
        "fn",
        "tn",
        "precision",
        "recall",
        "f1",
        "false_positive_rate"
      ],
      "title": "ConfusionMetrics",
      "type": "object"
    },
    "GroupBootstrapResult": {
      "additionalProperties": false,
      "properties": {
        "attempted_replicates": {
          "minimum": 0,
          "title": "Attempted Replicates",
          "type": "integer"
        },
        "group_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Group Ids",
          "type": "array"
        },
        "intervals": {
          "items": {
            "$ref": "#/$defs/IntervalEstimate"
          },
          "title": "Intervals",
          "type": "array"
        },
        "lower_rank": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Lower Rank"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "upper_rank": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Upper Rank"
        }
      },
      "required": [
        "group_ids",
        "attempted_replicates",
        "lower_rank",
        "upper_rank",
        "intervals"
      ],
      "title": "GroupBootstrapResult",
      "type": "object"
    },
    "IntervalEstimate": {
      "additionalProperties": false,
      "properties": {
        "defined_replicates": {
          "minimum": 0,
          "title": "Defined Replicates",
          "type": "integer"
        },
        "lower": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Lower"
        },
        "metric": {
          "minLength": 1,
          "title": "Metric",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "undefined_replicates": {
          "minimum": 0,
          "title": "Undefined Replicates",
          "type": "integer"
        },
        "upper": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Upper"
        }
      },
      "required": [
        "metric",
        "lower",
        "upper",
        "defined_replicates",
        "undefined_replicates",
        "reason"
      ],
      "title": "IntervalEstimate",
      "type": "object"
    },
    "MetricValue": {
      "additionalProperties": false,
      "description": "Exact rational estimate, or an explicit undefined denominator/reason.",
      "properties": {
        "denominator": {
          "minimum": 0,
          "title": "Denominator",
          "type": "integer"
        },
        "numerator": {
          "minimum": 0,
          "title": "Numerator",
          "type": "integer"
        },
        "reason": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "numerator",
        "denominator",
        "value",
        "reason"
      ],
      "title": "MetricValue",
      "type": "object"
    },
    "PairedEstimateV2": {
      "additionalProperties": false,
      "properties": {
        "estimate": {
          "$ref": "#/$defs/SignedMetricV2"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "schema_version": {
          "const": "2.0",
          "default": "2.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "estimate"
      ],
      "title": "PairedEstimateV2",
      "type": "object"
    },
    "PairwiseComparison": {
      "additionalProperties": false,
      "properties": {
        "coverage_confirmed": {
          "$ref": "#/$defs/MetricValue"
        },
        "coverage_scheduled": {
          "$ref": "#/$defs/MetricValue"
        },
        "divergent_cases": {
          "minimum": 0,
          "title": "Divergent Cases",
          "type": "integer"
        },
        "exclusions": {
          "items": {
            "$ref": "#/$defs/PairwiseExclusion"
          },
          "title": "Exclusions",
          "type": "array"
        },
        "group_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Group Ids",
          "type": "array"
        },
        "left_method": {
          "enum": [
            "R",
            "M",
            "B",
            "H"
          ],
          "title": "Left Method",
          "type": "string"
        },
        "left_metrics": {
          "$ref": "#/$defs/ConfusionMetrics"
        },
        "left_only": {
          "$ref": "#/$defs/PairwiseDirection"
        },
        "left_partial_alert_case_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Left Partial Alert Case Ids",
          "type": "array"
        },
        "normal_cases": {
          "minimum": 0,
          "title": "Normal Cases",
          "type": "integer"
        },
        "right_method": {
          "enum": [
            "R",
            "M",
            "B",
            "H"
          ],
          "title": "Right Method",
          "type": "string"
        },
        "right_metrics": {
          "$ref": "#/$defs/ConfusionMetrics"
        },
        "right_only": {
          "$ref": "#/$defs/PairwiseDirection"
        },
        "right_partial_alert_case_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Right Partial Alert Case Ids",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "support_case_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Support Case Ids",
          "type": "array"
        }
      },
      "required": [
        "left_method",
        "right_method",
        "support_case_ids",
        "group_ids",
        "divergent_cases",
        "normal_cases",
        "coverage_confirmed",
        "coverage_scheduled",
        "left_metrics",
        "right_metrics",
        "left_only",
        "right_only",
        "exclusions",
        "left_partial_alert_case_ids",
        "right_partial_alert_case_ids"
      ],
      "title": "PairwiseComparison",
      "type": "object"
    },
    "PairwiseDirection": {
      "additionalProperties": false,
      "description": "Alerts unique to one method on the shared complete, labelled support.",
      "properties": {
        "additional_false_positive_case_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Additional False Positive Case Ids",
          "type": "array"
        },
        "additional_false_positive_rate": {
          "$ref": "#/$defs/MetricValue"
        },
        "additional_true_positive_case_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Additional True Positive Case Ids",
          "type": "array"
        },
        "additional_true_positive_rate": {
          "$ref": "#/$defs/MetricValue"
        },
        "method": {
          "enum": [
            "R",
            "M",
            "B",
            "H"
          ],
          "title": "Method",
          "type": "string"
        },
        "reference": {
          "enum": [
            "R",
            "M",
            "B",
            "H"
          ],
          "title": "Reference",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "method",
        "reference",
        "additional_true_positive_case_ids",
        "additional_false_positive_case_ids",
        "additional_true_positive_rate",
        "additional_false_positive_rate"
      ],
      "title": "PairwiseDirection",
      "type": "object"
    },
    "PairwiseExclusion": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "minLength": 1,
          "title": "Case Id",
          "type": "string"
        },
        "oracle_state": {
          "enum": [
            "pending",
            "disagreement",
            "confirmed",
            "not_evaluable"
          ],
          "title": "Oracle State",
          "type": "string"
        },
        "reasons": {
          "items": {
            "enum": [
              "oracle_unconfirmed",
              "left_incomplete",
              "right_incomplete"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Reasons",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "oracle_state",
        "reasons"
      ],
      "title": "PairwiseExclusion",
      "type": "object"
    },
    "SignedMetricV2": {
      "additionalProperties": false,
      "properties": {
        "denominator": {
          "minimum": 0,
          "title": "Denominator",
          "type": "integer"
        },
        "numerator": {
          "title": "Numerator",
          "type": "integer"
        },
        "reason": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        },
        "schema_version": {
          "const": "2.0",
          "default": "2.0",
          "title": "Schema Version",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "numerator",
        "denominator",
        "value",
        "reason"
      ],
      "title": "SignedMetricV2",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "bootstrap": {
      "$ref": "#/$defs/GroupBootstrapResult"
    },
    "comparison": {
      "$ref": "#/$defs/PairwiseComparison"
    },
    "estimates": {
      "items": {
        "$ref": "#/$defs/PairedEstimateV2"
      },
      "title": "Estimates",
      "type": "array"
    },
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "comparison",
    "estimates",
    "bootstrap"
  ],
  "title": "PrincipalContrastV2",
  "type": "object"
}
