{
  "$defs": {
    "TrainingRecord": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "minLength": 1,
          "title": "Candidate Id",
          "type": "string"
        },
        "candidate_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Candidate Sha256",
          "type": "string"
        },
        "execution_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Execution Sha256",
          "type": "string"
        },
        "group_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Group Id",
          "type": "string"
        },
        "oracle_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Oracle Sha256",
          "type": "string"
        },
        "profile_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Profile Sha256",
          "type": "string"
        },
        "scenario_id": {
          "minLength": 1,
          "title": "Scenario Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "vector_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Vector Sha256",
          "type": "string"
        }
      },
      "required": [
        "scenario_id",
        "candidate_id",
        "group_id",
        "candidate_sha256",
        "oracle_sha256",
        "profile_sha256",
        "vector_sha256",
        "execution_sha256"
      ],
      "title": "TrainingRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "catalog_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Catalog Sha256",
      "type": "string"
    },
    "purpose": {
      "default": "normal_training",
      "title": "Purpose",
      "type": "string"
    },
    "records": {
      "items": {
        "$ref": "#/$defs/TrainingRecord"
      },
      "title": "Records",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "splits_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Splits Sha256",
      "type": "string"
    }
  },
  "required": [
    "catalog_sha256",
    "splits_sha256",
    "records"
  ],
  "title": "TrainingManifest",
  "type": "object"
}
