{
  "$defs": {
    "EvidenceFile": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "EvidenceFile",
      "type": "object"
    },
    "PublishedTable": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "parquet": {
          "$ref": "#/$defs/EvidenceFile"
        },
        "row_count": {
          "minimum": 0,
          "title": "Row Count",
          "type": "integer"
        },
        "source_format": {
          "enum": [
            "arrow",
            "parquet"
          ],
          "title": "Source Format",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "source_size_bytes": {
          "minimum": 0,
          "title": "Source Size Bytes",
          "type": "integer"
        },
        "verification_id": {
          "minLength": 1,
          "title": "Verification Id",
          "type": "string"
        },
        "verification_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Verification Sha256",
          "type": "string"
        }
      },
      "required": [
        "name",
        "source_sha256",
        "source_size_bytes",
        "source_format",
        "parquet",
        "row_count",
        "verification_id",
        "verification_sha256"
      ],
      "title": "PublishedTable",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "guarantee": {
      "const": "local_atomic_pointer",
      "default": "local_atomic_pointer",
      "title": "Guarantee",
      "type": "string"
    },
    "identity_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Identity Sha256",
      "type": "string"
    },
    "policy": {
      "enum": [
        "create",
        "replace"
      ],
      "title": "Policy",
      "type": "string"
    },
    "previous_run": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Previous Run"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "tables": {
      "items": {
        "$ref": "#/$defs/PublishedTable"
      },
      "title": "Tables",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "policy",
    "identity_sha256",
    "previous_run",
    "tables"
  ],
  "title": "LoadReceipt",
  "type": "object"
}
