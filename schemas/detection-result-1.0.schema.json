{
  "$defs": {
    "ComponentDecision": {
      "additionalProperties": false,
      "properties": {
        "complete": {
          "title": "Complete",
          "type": "boolean"
        },
        "decision": {
          "enum": [
            "alert",
            "no_alert",
            "not_evaluable"
          ],
          "title": "Decision",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "decision",
        "complete"
      ],
      "title": "ComponentDecision",
      "type": "object"
    },
    "DetectorDecision": {
      "additionalProperties": false,
      "properties": {
        "result": {
          "$ref": "#/$defs/ComponentDecision"
        },
        "score": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "const": "+infinity",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Score"
        },
        "threshold": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Threshold"
        }
      },
      "required": [
        "result",
        "score",
        "threshold"
      ],
      "title": "DetectorDecision",
      "type": "object"
    },
    "DetectorScoreResult": {
      "additionalProperties": false,
      "properties": {
        "b": {
          "$ref": "#/$defs/DetectorScores"
        },
        "fit_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Fit Sha256",
          "type": "string"
        },
        "m": {
          "$ref": "#/$defs/DetectorScores"
        },
        "matrix_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Matrix Sha256"
        },
        "rows": {
          "minimum": 0,
          "title": "Rows",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "fit_sha256",
        "matrix_sha256",
        "rows",
        "m",
        "b"
      ],
      "title": "DetectorScoreResult",
      "type": "object"
    },
    "DetectorScores": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "state": {
          "enum": [
            "scored",
            "not_estimable"
          ],
          "title": "State",
          "type": "string"
        },
        "values": {
          "default": [],
          "items": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "number"
              },
              {
                "const": "+infinity",
                "type": "string"
              }
            ]
          },
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "state"
      ],
      "title": "DetectorScores",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "b": {
      "items": {
        "$ref": "#/$defs/DetectorDecision"
      },
      "title": "B",
      "type": "array"
    },
    "bundle_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Bundle Sha256",
      "type": "string"
    },
    "m": {
      "items": {
        "$ref": "#/$defs/DetectorDecision"
      },
      "title": "M",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scores": {
      "$ref": "#/$defs/DetectorScoreResult"
    }
  },
  "required": [
    "bundle_sha256",
    "scores",
    "m",
    "b"
  ],
  "title": "DetectionResult",
  "type": "object"
}
